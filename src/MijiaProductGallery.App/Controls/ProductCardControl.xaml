<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MijiaProductGallery.App.Controls.ProductCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" CanDrag="True">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="CardBorder.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                        <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                        <Setter Target="HoverCopyButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Target="CardBorder.Background" Value="{ThemeResource CardBackgroundFillColorTertiaryBrush}" />
                        <Setter Target="HoverCopyButton.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DragCue">
                    <VisualState.Setters>
                        <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border
            x:Name="CardBorder"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 统一图片区域 -->
                <Grid Grid.Row="0" Margin="10,10,10,0">
                    <Image
                        x:Name="CardImage"
                        Source="{Binding ThumbnailPath, Mode=OneWay, Converter={StaticResource PathToImage}}"
                        Stretch="Uniform"
                        Visibility="{Binding ShowImage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <ProgressRing
                        IsActive="{Binding ShowLoading, Mode=OneWay}"
                        Visibility="{Binding ShowLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Width="24"
                        Height="24" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="4"
                        Visibility="{Binding ShowFailed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="{Binding FailureText, Mode=OneWay}"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                    <FontIcon
                        x:Name="FavoriteBadge"
                        Glyph="&#xE735;"
                        FontSize="14"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="{Binding ShowFavoriteBadge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="已收藏" />
                    <Button
                        x:Name="HoverCopyButton"
                        Content="复制图片"
                        FontSize="11.5"
                        Padding="8,3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Visibility="Collapsed"
                        Click="OnHoverCopyClick" />
                </Grid>

                <!-- 文本区：名称 → 型号 → 品牌·分类 -->
                <StackPanel Grid.Row="1" Margin="10,8,10,10" Spacing="2">
                    <TextBlock
                        Text="{Binding Name}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding Name}" />
                    <TextBlock
                        Text="{Binding Model}"
                        FontSize="11"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        ToolTipService.ToolTip="{Binding Model}" />
                    <TextBlock
                        Text="{Binding BrandCategory}"
                        FontSize="11"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        Text="{Binding RecentInfo, Mode=OneWay}"
                        FontSize="11"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="{Binding RecentInfo, Mode=OneWay, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Grid>

            <Border.ContextFlyout>
                <MenuFlyout x:Name="CardContextMenu" Opening="OnMenuFlyoutOpening">
                    <MenuFlyoutSubItem Text="复制">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </MenuFlyoutSubItem.Icon>
                        <MenuFlyoutItem x:Name="MenuCopyImage" Text="复制图片" Click="OnMenuCopyImageClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="复制产品名称" Click="OnMenuCopyNameClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="复制型号" Click="OnMenuCopyModelClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="复制品牌" Click="OnMenuCopyBrandClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="复制完整信息" Click="OnMenuCopyFullInfoClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSubItem x:Name="MenuAddToCollection" Text="添加到收藏夹">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </MenuFlyoutSubItem.Icon>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem x:Name="MenuFavorite" Click="OnMenuFavoriteClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE734;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Border.ContextFlyout>
        </Border>
    </Grid>
</UserControl>
