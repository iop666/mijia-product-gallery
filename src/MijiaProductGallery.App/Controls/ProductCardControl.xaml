<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MijiaProductGallery.App.Controls.ProductCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="CardBorder.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                        <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="CardBorder.Translation" Value="0,-2,0" />
                        <Setter Target="HoverCopyButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Target="CardBorder.Background" Value="{ThemeResource CardBackgroundFillColorTertiaryBrush}" />
                        <Setter Target="CardBorder.Translation" Value="0,0,0" />
                        <Setter Target="HoverCopyButton.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DragCue">
                    <VisualState.Setters>
                        <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="CardBorder.Translation" Value="0,-3,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border
            x:Name="CardBorder"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="8">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Image
                        x:Name="CardImage"
                        Source="{Binding ThumbnailPath, Mode=OneWay, Converter={StaticResource PathToImage}}"
                        Stretch="Uniform"
                        Visibility="{Binding ShowImage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <ProgressRing
                        IsActive="{Binding ShowLoading, Mode=OneWay}"
                        Visibility="{Binding ShowLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Width="28"
                        Height="28" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="4"
                        Visibility="{Binding ShowFailed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon Glyph="&#xE7BA;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="{Binding FailureText, Mode=OneWay}"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        x:Name="FavoriteBadge"
                        Text="&#xE735;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="15"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="{Binding ShowFavoriteBadge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="已收藏" />
                    <Button
                        x:Name="HoverCopyButton"
                        Content="复制图片"
                        FontSize="11.5"
                        Padding="8,3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Visibility="Collapsed"
                        Click="OnHoverCopyClick" />
                </Grid>

                <StackPanel Grid.Row="1" Spacing="2">
                    <TextBlock
                        Text="{Binding Name}"
                        FontSize="12.5"
                        TextWrapping="Wrap"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{Binding Name}" />
                    <TextBlock
                        Text="{Binding Brand}"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{Binding Category}"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="MenuCopyImage" Text="复制图片" Click="OnMenuCopyImageClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="复制产品名称" Click="OnMenuCopyNameClick" />
                    <MenuFlyoutItem Text="复制型号" Click="OnMenuCopyModelClick" />
                    <MenuFlyoutItem Text="复制品牌" Click="OnMenuCopyBrandClick" />
                    <MenuFlyoutItem Text="复制完整信息" Click="OnMenuCopyFullInfoClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="MenuFavorite" Click="OnMenuFavoriteClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE734;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Border.ContextFlyout>
        </Border>
    </Grid>
</UserControl>
