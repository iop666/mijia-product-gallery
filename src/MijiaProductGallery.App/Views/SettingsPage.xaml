<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MijiaProductGallery.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="22" MaxWidth="680" HorizontalAlignment="Left">

            <!-- 常规 -->
            <StackPanel Spacing="10">
                <TextBlock Text="常规" FontSize="18" FontWeight="SemiBold" />
                <StackPanel Spacing="6">
                    <TextBlock Text="主题" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="ThemeBox" MinWidth="160" DropDownOpened="OnComboOpening" SelectionChanged="OnThemeSelectionChanged">
                        <ComboBoxItem Content="跟随系统" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                        <ComboBoxItem Content="灰色" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="启动视图" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="LaunchViewBox" MinWidth="160" DropDownOpened="OnComboOpening" SelectionChanged="OnLaunchViewSelectionChanged">
                        <ComboBoxItem Content="图库" />
                        <ComboBoxItem Content="收藏视图" />
                        <ComboBoxItem Content="最近使用" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- 图库 -->
            <StackPanel Spacing="10">
                <TextBlock Text="图库" FontSize="18" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="浏览模式" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="BrowseModeBox" MinWidth="160" DropDownOpened="OnComboOpening" SelectionChanged="OnBrowseModeSelectionChanged">
                            <ComboBoxItem Content="分页（默认）" />
                            <ComboBoxItem Content="连续滚动" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="每页显示数量（9–140）" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="PageSizeBox" MinWidth="160" DropDownOpened="OnComboOpening" SelectionChanged="OnPageSizeSelectionChanged">
                            <ComboBoxItem Content="9" />
                            <ComboBoxItem Content="12" />
                            <ComboBoxItem Content="15" />
                            <ComboBoxItem Content="21" />
                            <ComboBoxItem Content="28" />
                            <ComboBoxItem Content="35" />
                            <ComboBoxItem Content="56" />
                            <ComboBoxItem Content="70" />
                            <ComboBoxItem Content="105" />
                            <ComboBoxItem Content="140" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="缩略图最长边（120–960 px）" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="ThumbEdgeBox" MinWidth="120" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="WebP 质量（40–100）" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="ThumbQualityBox" MinWidth="120" />
                    </StackPanel>
                    <Button Content="应用" VerticalAlignment="Bottom" Click="OnThumbApplyClick" />
                </StackPanel>
                <TextBlock
                    Text="修改后仅影响新生成的缩略图；可在数据区清空缩略图缓存后全量重建。"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- 行为 -->
            <StackPanel Spacing="10">
                <TextBlock Text="行为" FontSize="18" FontWeight="SemiBold" />
                <CheckBox Content="记录“查看详情”行为" IsChecked="{Binding RecordViews, Mode=TwoWay}" />
                <CheckBox Content="记录“复制”行为" IsChecked="{Binding RecordCopies, Mode=TwoWay}" />
                <CheckBox Content="记录“拖拽”行为" IsChecked="{Binding RecordDrags, Mode=TwoWay}" />
            </StackPanel>

            <!-- 数据 -->
            <StackPanel Spacing="10">
                <TextBlock Text="数据" FontSize="18" FontWeight="SemiBold" />
                <TextBlock
                    Text="{Binding DataRoot, Mode=OneWay}"
                    FontSize="12.5"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="立即备份数据库" Click="OnBackupNowClick" />
                    <Button Content="清空缩略图缓存" Click="OnClearThumbCacheClick" />
                    <Button Content="清空最近使用记录…" Click="OnClearHistoryClick" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="备份文件" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox
                        x:Name="BackupFilesBox"
                        MinWidth="320"
                        PlaceholderText="选择备份文件"
                        SelectionChanged="OnBackupSelectionChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="恢复选中的备份" Click="OnRestoreBackupClick" />
                        <Button Content="删除备份" Click="OnDeleteBackupClick" />
                        <Button Content="刷新列表" Click="OnRefreshBackupsClick" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- 同步 -->
            <StackPanel Spacing="10">
                <TextBlock Text="同步" FontSize="18" FontWeight="SemiBold" />
                <StackPanel Spacing="6">
                    <TextBlock Text="自动同步频率（详细状态请前往同步中心）" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="SyncIntervalBox" DropDownOpened="OnComboOpening" MinWidth="160" SelectionChanged="OnSyncIntervalSelectionChanged">
                        <ComboBoxItem Content="关闭" />
                        <ComboBoxItem Content="每次启动" />
                        <ComboBoxItem Content="每 6 小时" />
                        <ComboBoxItem Content="每天" />
                        <ComboBoxItem Content="每周" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- 关于 -->
            <StackPanel Spacing="10">
                <TextBlock Text="关于" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding AppVersion, Mode=OneWay}" FontSize="13" />
                <TextBlock
                    Text="{Binding DataSourceDescription}"
                    FontSize="12.5"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- 操作结果通知 -->
            <InfoBar
                x:Name="NoticeBar"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational"
                Title="提示"
                HorizontalAlignment="Left"
                MaxWidth="680" />
        </StackPanel>
    </ScrollViewer>
</Page>
