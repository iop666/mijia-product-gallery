<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MijiaProductGallery.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:MijiaProductGallery.Core.Interfaces"
    xmlns:local="using:MijiaProductGallery.App.Converters"
    xmlns:vm="using:MijiaProductGallery.ViewModels">

    <Grid>
    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="22" MaxWidth="680" HorizontalAlignment="Left">

            <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" />

            <!-- 常规 -->
            <StackPanel Spacing="10">
                <TextBlock Text="常规" FontSize="18" FontWeight="SemiBold" />
                <StackPanel Spacing="6">
                    <TextBlock Text="主题" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="ThemeBox" MinWidth="160" DropDownOpened="OnComboOpening" SelectionChanged="OnThemeSelectionChanged">
                        <ComboBoxItem Content="跟随系统" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                        <ComboBoxItem Content="灰色" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="启动视图" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="LaunchViewBox" MinWidth="160" DropDownOpened="OnComboOpening" SelectionChanged="OnLaunchViewSelectionChanged">
                        <ComboBoxItem Content="图库" />
                        <ComboBoxItem Content="收藏视图" />
                        <ComboBoxItem Content="最近使用" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- 图库 -->
            <StackPanel Spacing="10">
                <TextBlock Text="图库" FontSize="18" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="浏览模式" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="BrowseModeBox" MinWidth="160" DropDownOpened="OnComboOpening" SelectionChanged="OnBrowseModeSelectionChanged">
                            <ComboBoxItem Content="分页（默认）" />
                            <ComboBoxItem Content="连续滚动" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="PageSizeHeader" Text="每页显示数量（9–140）" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="PageSizeBox" MinWidth="160" DropDownOpened="OnComboOpening" SelectionChanged="OnPageSizeSelectionChanged">
                            <ComboBoxItem Content="9" />
                            <ComboBoxItem Content="12" />
                            <ComboBoxItem Content="15" />
                            <ComboBoxItem Content="21" />
                            <ComboBoxItem Content="28" />
                            <ComboBoxItem Content="35" />
                            <ComboBoxItem Content="56" />
                            <ComboBoxItem Content="70" />
                            <ComboBoxItem Content="105" />
                            <ComboBoxItem Content="140" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- 行为 -->
            <StackPanel Spacing="10">
                <TextBlock Text="行为" FontSize="18" FontWeight="SemiBold" />
                <CheckBox Content="记录“查看详情”行为" IsChecked="{Binding RecordViews, Mode=TwoWay}" />
                <CheckBox Content="记录“复制”行为" IsChecked="{Binding RecordCopies, Mode=TwoWay}" />
                <CheckBox Content="记录“拖拽”行为" IsChecked="{Binding RecordDrags, Mode=TwoWay}" />
            </StackPanel>

            <!-- 数据 -->
            <StackPanel Spacing="10">
                <TextBlock Text="数据" FontSize="18" FontWeight="SemiBold" />
                <TextBlock
                    Text="{Binding DataRoot, Mode=OneWay}"
                    FontSize="12.5"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="BackupNowButton" Content="立即备份数据库" Click="OnBackupNowClick" />
                    <Button x:Name="ClearThumbCacheButton" Content="清空缩略图缓存" Click="OnClearThumbCacheClick" />
                    <Button x:Name="ClearHistoryButton" Content="清空最近使用记录…" Click="OnClearHistoryClick" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="备份文件" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox
                        x:Name="BackupFilesBox"
                        MinWidth="420"
                        PlaceholderText="选择备份文件"
                        AutomationProperties.Name="备份文件列表">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="core:BackupEntry">
                                <Grid MinWidth="380" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="0">
                                        <TextBlock Text="{x:Bind FileName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind local:UiConverters.FormatUnixTime(CreatedUnix)}"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind local:UiConverters.FormatFileSize(SizeBytes)}"
                                        FontSize="12"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="RestoreBackupButton" Content="恢复选中的备份" Click="OnRestoreBackupClick" />
                        <Button x:Name="DeleteBackupButton" Content="删除备份" Click="OnDeleteBackupClick" />
                        <Button x:Name="RefreshBackupsButton" Content="刷新列表" Click="OnRefreshBackupsClick" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- 使用说明 -->
            <StackPanel Spacing="10">
                <TextBlock Text="使用说明" FontSize="18" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding HelpGroups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HelpGroup">
                            <StackPanel Margin="0,6,0,0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind Icon}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind Items}" Margin="26,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock
                                                Text="{x:Bind}"
                                                FontSize="12.5"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                IsTextSelectionEnabled="True" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 关于 -->
            <StackPanel Spacing="10">
                <TextBlock Text="关于" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding AppVersion, Mode=OneWay}" FontSize="13" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="开源地址：" FontSize="13" VerticalAlignment="Center" />
                    <HyperlinkButton
                        Content="github.com/iop666/mijia-product-gallery"
                        NavigateUri="https://github.com/iop666/mijia-product-gallery" />
                </StackPanel>
                <TextBlock
                    Text="本应用仅供个人学习、研究与软件测试使用，严禁商用。"
                    FontSize="12.5"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{Binding DataSourceDescription}"
                    FontSize="12.5"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

    <!-- 操作结果通知：浮于页面底部，长页面滚动时也始终可见 -->
    <InfoBar
        x:Name="NoticeBar"
        AutomationProperties.LiveSetting="Polite"
        IsOpen="False"
        IsClosable="True"
        Severity="Informational"
        Title="提示"
        MaxWidth="680"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Margin="24,0,24,20" />
    </Grid>
</Page>
