<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MijiaProductGallery.App.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="18" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="统计" FontSize="22" FontWeight="SemiBold" />
                <ProgressRing
                    IsActive="{Binding IsLoading, Mode=OneWay}"
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <InfoBar
                IsOpen="{Binding HasError, Mode=OneWay}"
                IsClosable="False"
                Severity="Error"
                Title="统计数据加载失败"
                Message="{Binding ErrorMessage, Mode=OneWay}"
                Visibility="{Binding HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="今日" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding TodayCount, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="本周" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding WeekCount, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="本月" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding MonthCount, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="累计" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalCount, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="图库概览" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="产品总数" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding GalleryTotalCount, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="有图片" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding GalleryWithImageCount, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="无图片" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding GalleryWithoutImageCount, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="官网已移除" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding GalleryRemovedCount, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="各大类数量" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <Border Style="{StaticResource StatCardStyle}" Padding="14,8">
                <ItemsControl ItemsSource="{Binding CategoryStats, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" Padding="6,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Category}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Count}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="最常使用" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding TopProducts, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Model}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding TotalUseCount}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                Text="暂无使用记录"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{Binding TopProductsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</Page>
