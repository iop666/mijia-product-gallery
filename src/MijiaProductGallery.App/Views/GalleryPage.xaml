<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MijiaProductGallery.App.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MijiaProductGallery.App.Controls"
    xmlns:local="using:MijiaProductGallery.App.Converters"
    xmlns:vm="using:MijiaProductGallery.ViewModels">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        <KeyboardAccelerator Key="Left" Invoked="OnPageNavInvoked" />
        <KeyboardAccelerator Key="Right" Invoked="OnPageNavInvoked" />
        <KeyboardAccelerator Key="PageUp" Invoked="OnPageNavInvoked" />
        <KeyboardAccelerator Key="PageDown" Invoked="OnPageNavInvoked" />
        <KeyboardAccelerator Key="Home" Invoked="OnPageNavInvoked" />
        <KeyboardAccelerator Key="End" Invoked="OnPageNavInvoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <DataTemplate x:Key="ProductCardTemplate" x:DataType="vm:ProductCard">
            <controls:ProductCardControl Card="{x:Bind}" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 内容列：工具行 / Chip 行 / 随机横幅 / 卡片网格 -->
        <Grid Grid.Column="0" RowSpacing="8" Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 工具行：结果摘要 + 操作区（随机/排序/筛选/清除） -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="{Binding ResultSummary, Mode=OneWay}"
                    FontSize="13"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{Binding HasResultSummary, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <Button
                    Grid.Column="1"
                    Click="OnRandomEnterClick"
                    ToolTipService.ToolTip="随机浏览一批产品">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                        <TextBlock Text="随机" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="2"
                    ToolTipService.ToolTip="选择排序方式">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                        <TextBlock Text="排序" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="SortFlyout" Placement="Bottom" Opening="OnFlyoutOpening">
                            <MenuFlyoutItem Text="默认排序" Tag="default" Click="OnSortItemClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="名称 A→Z" Tag="Name:Ascending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="名称 Z→A" Tag="Name:Descending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="型号 A→Z" Tag="Model:Ascending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="型号 Z→A" Tag="Model:Descending" Click="OnSortItemClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="使用次数 多→少" Tag="UsageCount:Descending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="使用次数 少→多" Tag="UsageCount:Ascending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="最近使用 新→旧" Tag="LastUsed:Descending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="最近使用 旧→新" Tag="LastUsed:Ascending" Click="OnSortItemClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="更新时间 新→旧" Tag="UpdateTime:Descending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="更新时间 旧→新" Tag="UpdateTime:Ascending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="添加时间 新→旧" Tag="AddedTime:Descending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="添加时间 旧→新" Tag="AddedTime:Ascending" Click="OnSortItemClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="FilterButton"
                    Grid.Column="3"
                    Click="OnFilterToggleClick"
                    ToolTipService.ToolTip="打开/关闭筛选面板">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71C;" FontSize="14" />
                        <TextBlock Text="筛选" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="4"
                    Content="清除全部"
                    Visibility="{Binding HasActiveChips, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Click="OnClearFiltersClick" />
            </Grid>

            <!-- Chip 行：已激活的搜索/筛选条件 -->
            <ItemsControl
                Grid.Row="1"
                ItemsSource="{Binding ActiveChips, Mode=OneWay}"
                Visibility="{Binding HasActiveChips, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FilterChip">
                        <Border
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    Text="{Binding Label}"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Button
                                    Content="&#xE711;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="9"
                                    Width="18"
                                    Height="18"
                                    Padding="0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    AutomationProperties.Name="移除筛选条件"
                                    ToolTipService.ToolTip="移除该条件"
                                    Tag="{Binding Id}"
                                    Click="OnChipRemoveClick" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 随机浏览横幅（仅随机模式可见） -->
            <Border
                Grid.Row="2"
                x:Name="RandomBanner"
                CornerRadius="8"
                Padding="14,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="{Binding IsRandomMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{Binding RandomBannerText, Mode=OneWay}"
                        VerticalAlignment="Center"
                        FontSize="13" />
                    <Button
                        Grid.Column="1"
                        Content="换一批"
                        IsEnabled="{Binding RandomExhausted, Mode=OneWay, Converter={StaticResource InverseBoolValue}}"
                        Click="OnRandomRefreshClick" />
                    <Button
                        Grid.Column="2"
                        Content="退出随机"
                        Click="OnRandomExitClick" />
                </Grid>
            </Border>

            <!-- 分页栏：固定内容区底部，不随卡片滚动；随机/连续滚动模式隐藏 -->
            <Border
                Grid.Row="4"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,6"
                HorizontalAlignment="Center"
                Visibility="{x:Bind Vm.IsPagerVisible, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                    <Button
                        Content="首页"
                        Click="OnFirstPageClick"
                        IsEnabled="{x:Bind Vm.CanGoFirstPage, Mode=OneWay}" />
                    <Button
                        Content="上一页"
                        Click="OnPrevPageClick"
                        IsEnabled="{x:Bind Vm.CanGoPrevPage, Mode=OneWay}" />
                    <TextBlock Text="第" VerticalAlignment="Center" FontSize="13" />
                    <TextBox
                        x:Name="PageBox"
                        Text="{x:Bind Vm.PageBoxText, Mode=OneWay}"
                        MinWidth="48"
                        TextAlignment="Center"
                        AutomationProperties.Name="页码跳转输入"
                        KeyDown="OnPageBoxKeyDown"
                        LostFocus="OnPageBoxLostFocus" />
                    <TextBlock Text="/" VerticalAlignment="Center" FontSize="13" />
                    <TextBlock Text="{x:Bind Vm.TotalPages, Mode=OneWay}" VerticalAlignment="Center" FontSize="13" />
                    <TextBlock Text="页" VerticalAlignment="Center" FontSize="13" />
                    <Button
                        Content="下一页"
                        Click="OnNextPageClick"
                        IsEnabled="{x:Bind Vm.CanGoNextPage, Mode=OneWay}" />
                    <Button
                        Content="末页"
                        Click="OnLastPageClick"
                        IsEnabled="{x:Bind Vm.CanGoLastPage, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- 卡片网格 -->
            <ScrollViewer
                Grid.Row="3"
                x:Name="CardsScroll"
                Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.IsReadyVisible), Mode=OneWay}">
                <ItemsRepeater
                    x:Name="CardsRepeater"
                    ItemsSource="{x:Bind Vm.Cards}"
                    ItemTemplate="{StaticResource ProductCardTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="184"
                            MinItemHeight="224"
                            MinRowSpacing="10"
                            MinColumnSpacing="10"
                            ItemsJustification="Center" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <!-- 加载中 -->
        <StackPanel
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.IsLoadingVisible), Mode=OneWay}">
            <ProgressRing IsActive="True" Width="42" Height="42" />
            <TextBlock Text="正在加载图库…" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 空图库 -->
        <StackPanel
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.IsEmptyVisible), Mode=OneWay}">
            <FontIcon Glyph="&#xE8B9;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="图库为空" HorizontalAlignment="Center" FontSize="18" />
            <TextBlock
                Text="尚未导入任何产品。可返回初始化页导入种子数据或进行在线初始化。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 加载失败 -->
        <StackPanel
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.IsErrorVisible), Mode=OneWay}">
            <FontIcon Glyph="&#xE783;" FontSize="40" Foreground="{ThemeResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="图库加载失败" HorizontalAlignment="Center" FontSize="18" />
            <TextBlock
                Text="{x:Bind Vm.ErrorMessage, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="480" />
            <Button Content="重试" HorizontalAlignment="Center" Click="OnRetryClick" />
        </StackPanel>

        <!-- 操作提示 -->
        <InfoBar
            Grid.Column="0"
            x:Name="NoticeBar"
            AutomationProperties.LiveSetting="Polite"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational"
            Title="提示"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,24" />

        <!-- 筛选面板：独立标题行 + 内容区，不进入系统标题栏区域 -->
        <Border
            Grid.Column="1"
            x:Name="FilterPaneBorder"
            Width="260"
            IsTabStop="True"
            UseSystemFocusVisuals="False"
            BorderThickness="1,0,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="{Binding FilterPane.IsOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Padding="14,12,10,8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <TextBlock Text="筛选" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        AutomationProperties.Name="关闭筛选面板"
                        ToolTipService.ToolTip="关闭筛选面板"
                        Click="OnFilterToggleClick">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" Padding="14,10">
                    <StackPanel Spacing="12" DataContext="{Binding FilterPane}">
                        <Expander
                            Header="大类"
                            IsExpanded="True"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0">
                            <ItemsControl ItemsSource="{Binding Categories}" Margin="4,0,0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Expander
                            Header="品牌"
                            IsExpanded="False"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0">
                            <StackPanel Margin="4,0,0,4">
                                <Grid Margin="0,0,0,6">
                                    <TextBox
                                        x:Name="BrandSearchBox"
                                        PlaceholderText="搜索品牌..."
                                        Padding="30,6,8,6"
                                        TextChanged="OnBrandSearchTextChanged" />
                                    <FontIcon
                                        Glyph="&#xE721;"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="9,0,0,0"
                                        IsHitTestVisible="False" />
                                </Grid>
                                <!-- 品牌 1400+：虚拟化列表只实例化可见项，展开瞬间完成 -->
                                <ScrollViewer Height="360">
                                    <ItemsRepeater ItemsSource="{Binding FilteredBrands}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Vertical" Spacing="0" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>
                            </StackPanel>
                        </Expander>

                        <StackPanel Spacing="6">
                            <TextBlock Text="状态" FontSize="13" FontWeight="SemiBold" />
                            <ComboBox
                                x:Name="AvailabilityCombo"
                                MinWidth="140"
                                SelectedIndex="0"
                                DropDownOpened="OnComboOpening"
                                SelectionChanged="OnAvailabilitySelectionChanged">
                                <ComboBoxItem Content="全部" />
                                <ComboBoxItem Content="在售" />
                                <ComboBoxItem Content="已下架" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="图片" FontSize="13" FontWeight="SemiBold" />
                            <ComboBox
                                x:Name="ImageCombo"
                                MinWidth="140"
                                SelectedIndex="0"
                                DropDownOpened="OnComboOpening"
                                SelectionChanged="OnImageSelectionChanged">
                                <ComboBoxItem Content="全部" />
                                <ComboBoxItem Content="有图片" />
                                <ComboBoxItem Content="无图片" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="使用次数" FontSize="13" FontWeight="SemiBold" />
                            <ComboBox
                                x:Name="UsageCombo"
                                MinWidth="140"
                                SelectedIndex="0"
                                SelectionChanged="OnUsageSelectionChanged">
                                <ComboBoxItem Content="全部" />
                                <ComboBoxItem Content="从未使用" />
                                <ComboBoxItem Content="已使用" />
                                <ComboBoxItem Content="高频使用" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="更新时间" FontSize="13" FontWeight="SemiBold" />
                            <ComboBox
                                x:Name="DateCombo"
                                MinWidth="140"
                                SelectedIndex="0"
                                DropDownOpened="OnComboOpening"
                                SelectionChanged="OnDateSelectionChanged">
                                <ComboBoxItem Content="全部" />
                                <ComboBoxItem Content="最近 7 天" />
                                <ComboBoxItem Content="最近 30 天" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
