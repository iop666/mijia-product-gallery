<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MijiaProductGallery.App.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MijiaProductGallery.App.Converters"
    xmlns:vm="using:MijiaProductGallery.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="ProductCardTemplate" x:DataType="vm:ProductCard">
            <Border
                Width="172"
                Height="204"
                Margin="6"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="8">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Image
                            Source="{x:Bind local:UiConverters.ToBitmapImage(ThumbnailPath), Mode=OneWay}"
                            Stretch="Uniform"
                            Visibility="{x:Bind local:UiConverters.ToVisibility(ShowImage), Mode=OneWay}" />
                        <ProgressRing
                            IsActive="{x:Bind ShowLoading, Mode=OneWay}"
                            Visibility="{x:Bind local:UiConverters.ToVisibility(ShowLoading), Mode=OneWay}"
                            Width="28"
                            Height="28" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="4"
                            Visibility="{x:Bind local:UiConverters.ToVisibility(ShowFailed), Mode=OneWay}">
                            <FontIcon Glyph="&#xE7BA;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Text="图片加载失败"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="2">
                        <TextBlock
                            Text="{x:Bind Name}"
                            FontSize="12.5"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Name}" />
                        <TextBlock
                            Text="{x:Bind Brand}"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind Category}"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer
            x:Name="CardsScroll"
            Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.IsReadyVisible), Mode=OneWay}">
            <ItemsRepeater
                x:Name="CardsRepeater"
                ItemsSource="{x:Bind Vm.Cards}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="172"
                        MinItemHeight="204"
                        MinRowSpacing="6"
                        MinColumnSpacing="6"
                        ItemsJustification="Start" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <StaticResource ResourceKey="ProductCardTemplate" />
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.IsLoadingVisible), Mode=OneWay}">
            <ProgressRing IsActive="True" Width="42" Height="42" />
            <TextBlock Text="正在加载图库…" HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.IsEmptyVisible), Mode=OneWay}">
            <FontIcon Glyph="&#xE8B9;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="图库为空" HorizontalAlignment="Center" FontSize="18" />
            <TextBlock
                Text="尚未导入任何产品。可返回初始化页导入种子数据或进行在线初始化。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.IsErrorVisible), Mode=OneWay}">
            <FontIcon Glyph="&#xE783;" FontSize="40" Foreground="{ThemeResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="图库加载失败" HorizontalAlignment="Center" FontSize="18" />
            <TextBlock
                Text="{x:Bind Vm.ErrorMessage, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="480" />
            <Button Content="重试" HorizontalAlignment="Center" Click="OnRetryClick" />
        </StackPanel>
    </Grid>
</Page>
