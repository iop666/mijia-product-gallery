<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MijiaProductGallery.App.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MijiaProductGallery.App.Controls"
    xmlns:local="using:MijiaProductGallery.App.Converters"
    xmlns:vm="using:MijiaProductGallery.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="ProductCardTemplate" x:DataType="vm:ProductCard">
            <controls:ProductCardControl Card="{x:Bind}" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" ColumnSpacing="8" Margin="12,8,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="{Binding ResultSummary, Mode=OneWay}"
                    FontSize="12.5"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{Binding HasResultSummary, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <Button Grid.Column="1" Click="OnFilterToggleClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71C;" FontSize="14" />
                        <TextBlock Text="筛选" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Click="OnSortMenuClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                        <TextBlock Text="排序" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="默认排序" Tag="default" Click="OnSortItemClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="名称 A→Z" Tag="Name:Ascending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="名称 Z→A" Tag="Name:Descending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="型号 A→Z" Tag="Model:Ascending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="型号 Z→A" Tag="Model:Descending" Click="OnSortItemClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="使用次数 多→少" Tag="UsageCount:Descending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="使用次数 少→多" Tag="UsageCount:Ascending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="最近使用 新→旧" Tag="LastUsed:Descending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="最近使用 旧→新" Tag="LastUsed:Ascending" Click="OnSortItemClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="更新时间 新→旧" Tag="UpdateTime:Descending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="更新时间 旧→新" Tag="UpdateTime:Ascending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="添加时间 新→旧" Tag="AddedTime:Descending" Click="OnSortItemClick" />
                            <MenuFlyoutItem Text="添加时间 旧→新" Tag="AddedTime:Ascending" Click="OnSortItemClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button
                    Grid.Column="2"
                    Content="清除全部"
                    Visibility="{Binding HasActiveChips, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Click="OnClearFiltersClick" />
            </Grid>
            <ItemsControl
                Grid.Row="1"
                ItemsSource="{Binding ActiveChips, Mode=OneWay}"
                Margin="12,0,0,0"
                Visibility="{Binding HasActiveChips, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="10"
                            Padding="10,3">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Text="{Binding Label}"
                                    FontSize="11.5"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                <Button
                                    Content="&#xE711;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="10"
                                    Padding="2,0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Tag="{Binding Id}"
                                    Click="OnChipRemoveClick" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ScrollViewer
                Grid.Row="2"
                x:Name="CardsScroll"
                Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.IsReadyVisible), Mode=OneWay}">
                <ItemsRepeater
                    x:Name="CardsRepeater"
                    ItemsSource="{x:Bind Vm.Cards}"
                    ItemTemplate="{StaticResource ProductCardTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="172"
                            MinItemHeight="204"
                            MinRowSpacing="6"
                            MinColumnSpacing="6"
                            ItemsJustification="Start" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <StackPanel
            Grid.Column="0"
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.IsLoadingVisible), Mode=OneWay}">
            <ProgressRing IsActive="True" Width="42" Height="42" />
            <TextBlock Text="正在加载图库…" HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.IsEmptyVisible), Mode=OneWay}">
            <FontIcon Glyph="&#xE8B9;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="图库为空" HorizontalAlignment="Center" FontSize="18" />
            <TextBlock
                Text="尚未导入任何产品。可返回初始化页导入种子数据或进行在线初始化。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.IsErrorVisible), Mode=OneWay}">
            <FontIcon Glyph="&#xE783;" FontSize="40" Foreground="{ThemeResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="图库加载失败" HorizontalAlignment="Center" FontSize="18" />
            <TextBlock
                Text="{x:Bind Vm.ErrorMessage, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="480" />
            <Button Content="重试" HorizontalAlignment="Center" Click="OnRetryClick" />
        </StackPanel>

        <InfoBar
            Grid.Column="0"
            x:Name="NoticeBar"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational"
            Title="提示"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,24" />

        <Border
            Grid.Column="1"
            x:Name="FilterPaneBorder"
            Width="320"
            BorderThickness="1,0,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="{Binding FilterPane.IsOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer Padding="16,12">
                <StackPanel Spacing="14" DataContext="{Binding FilterPane}">
                    <Grid>
                        <TextBlock Text="筛选" FontSize="16" FontWeight="SemiBold" />
                        <Button
                            Content="&#xE711;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="11"
                            Padding="4,2"
                            MinWidth="0"
                            MinHeight="0"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            Click="OnFilterToggleClick" />
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="大类" FontSize="13" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="品牌" FontSize="13" FontWeight="SemiBold" />
                        <ScrollViewer MaxHeight="180">
                            <ItemsControl ItemsSource="{Binding Brands}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="状态" FontSize="13" FontWeight="SemiBold" />
                        <ComboBox MinWidth="160" SelectedIndex="0" SelectionChanged="OnAvailabilitySelectionChanged">
                            <ComboBoxItem Content="全部" />
                            <ComboBoxItem Content="在售" />
                            <ComboBoxItem Content="已下架" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="图片" FontSize="13" FontWeight="SemiBold" />
                        <ComboBox MinWidth="160" SelectedIndex="0" SelectionChanged="OnImageSelectionChanged">
                            <ComboBoxItem Content="全部" />
                            <ComboBoxItem Content="有图片" />
                            <ComboBoxItem Content="无图片" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="使用次数" FontSize="13" FontWeight="SemiBold" />
                        <ComboBox MinWidth="160" SelectedIndex="0" SelectionChanged="OnUsageSelectionChanged">
                            <ComboBoxItem Content="全部" />
                            <ComboBoxItem Content="从未使用" />
                            <ComboBoxItem Content="已使用" />
                            <ComboBoxItem Content="高频使用" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="更新时间" FontSize="13" FontWeight="SemiBold" />
                        <ComboBox MinWidth="160" SelectedIndex="0" SelectionChanged="OnDateSelectionChanged">
                            <ComboBoxItem Content="全部" />
                            <ComboBoxItem Content="最近 7 天" />
                            <ComboBoxItem Content="最近 30 天" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
