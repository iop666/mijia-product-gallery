<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MijiaProductGallery.App.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MijiaProductGallery.App.Controls"
    xmlns:local="using:MijiaProductGallery.App.Converters"
    xmlns:vm="using:MijiaProductGallery.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="ProductCardTemplate" x:DataType="vm:ProductCard">
            <controls:ProductCardControl Card="{x:Bind}" />
        </DataTemplate>
    </Page.Resources>

    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Text="{x:Bind Vm.ResultSummary, Mode=OneWay}"
            FontSize="12.5"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Margin="12,8,0,0"
            Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.HasResultSummary), Mode=OneWay}" />
        <ScrollViewer
            Grid.Row="1"
            x:Name="CardsScroll"
            Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.IsReadyVisible), Mode=OneWay}">
            <ItemsRepeater
                x:Name="CardsRepeater"
                ItemsSource="{x:Bind Vm.Cards}"
                ItemTemplate="{StaticResource ProductCardTemplate}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="172"
                        MinItemHeight="204"
                        MinRowSpacing="6"
                        MinColumnSpacing="6"
                        ItemsJustification="Start" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.IsLoadingVisible), Mode=OneWay}">
            <ProgressRing IsActive="True" Width="42" Height="42" />
            <TextBlock Text="正在加载图库…" HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.IsEmptyVisible), Mode=OneWay}">
            <FontIcon Glyph="&#xE8B9;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="图库为空" HorizontalAlignment="Center" FontSize="18" />
            <TextBlock
                Text="尚未导入任何产品。可返回初始化页导入种子数据或进行在线初始化。"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind local:UiConverters.ToVisibility(Vm.IsErrorVisible), Mode=OneWay}">
            <FontIcon Glyph="&#xE783;" FontSize="40" Foreground="{ThemeResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="图库加载失败" HorizontalAlignment="Center" FontSize="18" />
            <TextBlock
                Text="{x:Bind Vm.ErrorMessage, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="480" />
            <Button Content="重试" HorizontalAlignment="Center" Click="OnRetryClick" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            x:Name="NoticeBar"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational"
            Title="提示"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,24" />
    </Grid>
</Page>
