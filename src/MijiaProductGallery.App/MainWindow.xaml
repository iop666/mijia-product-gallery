<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MijiaProductGallery.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="米家产品示例图库">
    <NavigationView
        x:Name="Nav"
        PaneDisplayMode="Left"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="180"
        ItemInvoked="OnItemInvoked">
        <NavigationView.AutoSuggestBox>
            <AutoSuggestBox
                x:Name="SearchBox"
                PlaceholderText="搜索产品..."
                QueryIcon="Find"
                TextChanged="OnSearchTextChanged"
                QuerySubmitted="OnSearchQuerySubmitted" />
        </NavigationView.AutoSuggestBox>
        <NavigationView.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnCtrlFInvoked" />
        </NavigationView.KeyboardAccelerators>
        <NavigationView.MenuItems>
            <NavigationViewItem Content="图库" Tag="gallery" IsSelected="True">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Pictures" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="收藏" Tag="favorites">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Favorite" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="最近使用" Tag="recent">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Clock" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="同步中心" Tag="sync" IsEnabled="False">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Sync" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="设置" Tag="settings" IsEnabled="False">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
